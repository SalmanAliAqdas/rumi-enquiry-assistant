# Local SQLite only. The directory is created at startup.
DATABASE_URL=sqlite:///./data/rumi.db
# HTTP localhost requires false. Set true only behind HTTPS in a future deployment.
COOKIE_SECURE=false
SESSION_MINUTES=60

# Explicit opt-in. Never overwrite an existing .env during upgrades.
PROCESSOR_MODE=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=1200
# Copy docs/faq.example.json here, review the facts, then approve individual entries.
FAQ_PATH=private/faq.json
