# Local defaults. Keep your existing .env; cloud setup is in docs/DEPLOYMENT.md.
DATABASE_URL=sqlite:///./data/rumi.db
# HTTP localhost requires false. Vercel requires true.
COOKIE_SECURE=false
SESSION_MINUTES=60

# Explicit opt-in. Never overwrite an existing .env during upgrades.
PROCESSOR_MODE=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=1200
# Copy docs/faq.example.json here, review the facts, then approve individual entries.
FAQ_PATH=private/faq.json

# Keep these local defaults; configure portfolio settings directly in Vercel.
PORTFOLIO_MODE=false
SHARED_LIMITS=false
PUBLIC_DEMO_LIVE=false
ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]","testserver"]
GEMINI_DAILY_LIMIT=10
GEMINI_TOTAL_LIMIT=100
